PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/secure-notes locally)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure-notes
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Used by `npm run seed:admin` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
